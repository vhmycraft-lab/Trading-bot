# QuantLab secrets — copy to `.env` and fill in.  `.env` is git-ignored (INV-2).
#
# Resolution order for every secret (see docs/SECURITY.md, spec section 21):
#   1. macOS Keychain  (service "quantlab", account = the variable name)
#   2. this `.env` file in the repository root
#   3. ConfigError("missing secret <name>; run quantlab doctor")
#
# NEVER commit real values. NEVER pass secrets as CLI flags or put them in configs/.

# Required for the LLM researcher (Phase H).  Not needed for Phase A-G work.
GLM_API_KEY=

# Optional, READ-ONLY key, used only to raise Binance public rate limits.
# `quantlab doctor` refuses to proceed if the key has spot/margin trading enabled.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- non-secret overrides (optional) ---------------------------------------
# Any scalar config value may be overridden with QUANTLAB__<SECTION>__<KEY>.
# QUANTLAB__LOGGING__LEVEL=DEBUG
# QUANTLAB__PROJECT__DB_PATH=./quantlab.db
